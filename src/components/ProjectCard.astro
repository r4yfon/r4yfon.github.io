---
import ProjectThumb from "@/components/ProjectThumb.astro";
import { formatMonth, type Project } from "@/lib/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { id, data } = project;
const pdi = [
  ["Problem", data.problem],
  ["Decision", data.decision],
  ["Impact", data.impact],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<li
  class="group/card spring relative grid gap-x-6 gap-y-1.5 rounded-2xl border border-transparent p-5 transition-[translate,rotate,background-color,border-color,box-shadow,opacity] duration-500 group-hover/list:opacity-55 hover:-translate-y-1 hover:-rotate-[0.25deg] hover:border-line hover:bg-surface hover:opacity-100! hover:shadow-[0_18px_40px_-24px_rgb(0_0_0/0.55)] focus-within:opacity-100! sm:grid-cols-[116px_minmax(0,1fr)]"
  data-blip>
  <ProjectThumb project={project} class="spring transition-transform duration-500 group-hover/card:scale-104 group-hover/card:rotate-[1.5deg]" />
  <div class="min-w-0">
    <span class="font-mono text-xs/[1.9] font-medium tracking-[0.06em] text-muted uppercase">{formatMonth(data.date)} · {data.role}</span>
    <h3 class="text-[1.05rem] leading-snug font-semibold">
      <a href={`/projects/${id}/`} class="after:absolute after:inset-0 after:rounded-2xl">
        <span class="inline-block" style={`view-transition-name: title-${id}; view-transition-class: project-title`}>{data.title}</span> <span class="spring inline-block text-peach transition-transform duration-450 group-hover/card:translate-x-1">→</span>
      </a>
    </h3>
    {
      pdi.length ? (
        <dl class="mt-3 grid gap-2">
          {pdi.map(([term, text]) => (
            <div class="grid grid-cols-[74px_minmax(0,1fr)] gap-2.5 text-[0.92rem]">
              <dt class:list={["font-mono text-[11px]/[1.9] font-medium tracking-[0.1em] uppercase", term === "Impact" ? "text-peach" : "text-peri"]}>{term}</dt>
              <dd class="text-muted">{text}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-1 text-[0.95rem] text-muted">{data.description}</p>
      )
    }
    {data.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{data.tags.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>
</li>
