---
import ProjectThumb from "@/components/ProjectThumb.astro";
import { formatMonth, projectStory, vt, type Project } from "@/lib/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { id, data } = project;
const story = projectStory(data);
---

<!--
  phone: one column (window, header, story).
  tablet/desktop: [window | header] on top, the problem/decision/impact story below:
  three columns when the card is wide enough for all three, otherwise one row each (never 2 + 1);
  labels sit beside their text in mid-width cards and above it in narrow ones.
-->
<li
  id={`project-${id}`}
  class="group/card @container/card lift relative grid scroll-mt-24 gap-x-5 gap-y-4 rounded-2xl border border-transparent p-5 group-hover/list:opacity-55 hover:-translate-y-1 hover:-rotate-[0.25deg] hover:border-line hover:bg-hover hover:opacity-100! hover:shadow-[0_18px_40px_-24px_rgb(0_0_0/0.55)] focus-within:opacity-100! sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
  data-blip>
  <!-- the screenshot sits in a small browser window so it reads as a product, not a picture -->
  <div class="spring rounded-xl border border-line bg-surface p-1.5 shadow-[0_12px_30px_-20px_rgb(0_0_0/0.6)] transition-transform duration-500 group-hover/card:-rotate-1 group-hover/card:scale-[1.02]" aria-hidden="true">
    <div class="flex items-center gap-1 px-1 pt-0.5 pb-1.5">
      <span class="size-1.5 rounded-full bg-[#ff5f57]"></span><span class="size-1.5 rounded-full bg-[#febc2e]"></span><span class="size-1.5 rounded-full bg-[#28c840]"></span>
    </div>
    <ProjectThumb project={project} framed />
  </div>

  <div class="min-w-0 sm:self-center">
    <span class="font-mono text-xs/[1.9] font-medium tracking-[0.06em] text-muted uppercase">{formatMonth(data.date)} · {data.role}</span>
    <h3 class="text-lg leading-snug font-semibold">
      <a href={`/projects/${id}/`} class="after:absolute after:inset-0 after:rounded-2xl">
        <span class="inline-block" style={vt.title(id)}>{data.title}</span>
      </a>
    </h3>
    {data.tags.length > 0 && <div class="mt-2.5 flex flex-wrap gap-1.5">{data.tags.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>

  {
    story.length ? (
      <dl class="grid gap-x-5 gap-y-3 sm:col-span-2 sm:border-t sm:border-line sm:pt-4 @min-[38rem]/card:grid-cols-3">
        {story.map(({ term, text, highlight }) => (
          <div class="grid content-start gap-1 text-[0.92rem] @min-[28rem]/card:grid-cols-[88px_minmax(0,1fr)] @min-[28rem]/card:gap-4 @min-[38rem]/card:grid-cols-1 @min-[38rem]/card:gap-1">
            <dt class:list={["label leading-[1.9]", highlight ? "text-peach" : "text-peri"]}>{term}</dt>
            <dd class="text-muted">{text}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="text-[0.95rem] text-muted sm:col-span-2">{data.description}</p>
    )
  }
</li>
