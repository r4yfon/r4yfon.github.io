---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ProjectThumb from "@/components/ProjectThumb.astro";
import { formatMonth, type Project } from "@/lib/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { id, data } = project;
const pdi = [
  ["Problem", data.problem],
  ["Decision", data.decision],
  ["Impact", data.impact],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<!--
  phone: one column (window, header, story).
  tablet/desktop: [window | header] on top, the problem/decision/impact story across the full width below.
-->
<li
  class="group/card spring relative grid gap-x-5 gap-y-4 rounded-2xl border border-transparent p-5 transition-[translate,rotate,background-color,border-color,box-shadow,opacity] duration-500 group-hover/list:opacity-55 hover:-translate-y-1 hover:-rotate-[0.25deg] hover:border-line hover:bg-surface hover:opacity-100! hover:shadow-[0_18px_40px_-24px_rgb(0_0_0/0.55)] focus-within:opacity-100! sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
  data-blip>
  <!-- the screenshot sits in a small browser window so it reads as a product, not a picture -->
  <div class="spring rounded-xl border border-line bg-surface p-1.5 shadow-[0_12px_30px_-20px_rgb(0_0_0/0.6)] transition-transform duration-500 group-hover/card:-rotate-1 group-hover/card:scale-[1.02]" aria-hidden="true">
    <div class="flex items-center gap-1 px-1 pt-0.5 pb-1.5">
      <i class="size-1.5 rounded-full bg-line"></i><i class="size-1.5 rounded-full bg-line"></i><i class="size-1.5 rounded-full bg-line"></i>
    </div>
    <ProjectThumb project={project} framed />
  </div>

  <div class="min-w-0 sm:self-center">
    <span class="font-mono text-xs/[1.9] font-medium tracking-[0.06em] text-muted uppercase">{formatMonth(data.date)} · {data.role}</span>
    <h3 class="text-lg leading-snug font-semibold">
      <a href={`/projects/${id}/`} class="after:absolute after:inset-0 after:rounded-2xl">
        <span class="inline-block" style={`view-transition-name: title-${id}; view-transition-class: project-title`}>{data.title}</span> <ArrowRight class="spring inline-block size-4 align-[-2px] text-peach transition-transform duration-450 group-hover/card:translate-x-1" aria-hidden="true" />
      </a>
    </h3>
    {data.tags.length > 0 && <div class="mt-2.5 flex flex-wrap gap-1.5">{data.tags.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>

  {
    pdi.length ? (
      <dl class="grid gap-x-5 gap-y-2.5 sm:col-span-2 sm:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] sm:border-t sm:border-line sm:pt-4">
        {pdi.map(([term, text]) => (
          <div class="grid grid-cols-[74px_minmax(0,1fr)] gap-2.5 text-[0.92rem] sm:grid-cols-1 sm:gap-1">
            <dt class:list={["font-mono text-[11px]/[1.9] font-medium tracking-[0.1em] uppercase", term === "Impact" ? "text-peach" : "text-peri"]}>{term}</dt>
            <dd class="text-muted">{text}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="text-[0.95rem] text-muted sm:col-span-2">{data.description}</p>
    )
  }
</li>
