---
/**
 * A project's image (thumbnail, else app logo, else a tinted tile with its initials).
 * Carries `thumb-<id>` so it morphs into the hero on the project page.
 */
import { Picture } from "astro:assets";
import { projectMedia, vt, widthsFor, type Project } from "@/lib/projects";

interface Props {
  project: Project;
  class?: string;
  eager?: boolean;
  /** sits inside a frame (ProjectCard's browser window), so drop its own border and large radius */
  framed?: boolean;
  /** how wide it's shown, for picking a size from the srcset; defaults to a project card's thumbnail */
  sizes?: string;
}
const { project, class: className, eager = false, framed = false, sizes = "(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" } = Astro.props;
const media = projectMedia(project.id);
const src = media.thumbnail ?? media.logo;
const tints = ["#adbbd6, #7f95c4", "#e9d2bb, #d9ad84", "#c9d3e6, #e9d2bb", "#9fd3b6, #adbbd6"];
const tint = tints[[...project.id].reduce((n, c) => n + c.charCodeAt(0), 0) % tints.length];
const initials = project.data.title.replace(/[^A-Za-z ]/g, "").split(" ").map((w) => w[0]).join("").slice(0, 3);
---

<div
  class:list={["grid aspect-16/10 max-w-full place-items-center overflow-hidden", framed ? "rounded-md" : "rounded-[10px] border border-line", className]}
  style={`view-transition-name: ${vt.thumb(project.id)}; view-transition-class: project-thumb; background: linear-gradient(135deg, ${tint})`}
  data-vt-thumb>
  {
    src ? (
      <Picture
        src={src}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={widthsFor(src, [240, 400, 640, 960, 1280])}
        sizes={sizes}
        pictureAttributes={{ class: "contents" }}
        class={media.thumbnail ? "size-full object-cover object-top" : "size-3/5 object-contain"}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={eager ? "high" : undefined}
      />
    ) : (
      <span class="font-display text-2xl text-[#1a1410]">{initials}</span>
    )
  }
</div>
