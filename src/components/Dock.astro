---
/**
 * Floating action bar (resume, email, socials). It slides up once the page's `[data-hero]`
 * element has left the screen.
 * - Home: tablet/phone only, since on desktop the sticky sidebar already holds these actions.
 *   Its ☰ button opens the section sheet (SectionNav).
 * - Project pages: every width, since there's no sidebar there; on tablet/phone it's
 *   pinned (visible from the start) rather than waiting for a scroll. Its ← button leads
 *   back to the project grid, since the header's links scroll away.
 */
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Check from "@lucide/astro/icons/check";
import Mail from "@lucide/astro/icons/mail";
import GitHub from "@/components/icons/GitHub.astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import Sections from "@/components/icons/Sections.astro";
import { site } from "@/data/site";

interface Props {
  /** show the ☰ button that opens the section sheet (needs <SectionNav /> on the page) */
  sections?: boolean;
  /** show the ← button back to the project grid, linking here */
  back?: string;
  /** keep the dock on desktop too */
  desktop?: boolean;
  /** below `lg`, show it immediately instead of after the hero scrolls away */
  pinnedOnSmall?: boolean;
}
const { sections = false, back, desktop = false, pinnedOnSmall = false } = Astro.props;
---

<nav class:list={["dock", { "dock--desktop": desktop }]} aria-label="Quick actions" data-shown="false" data-pinned-small={pinnedOnSmall ? "" : undefined} inert>
  {
    back && (
      <>
        <a class="icon-btn dock-btn" href={back} aria-label="All projects" data-back-home data-blip>
          <ArrowLeft />
        </a>
        <span class="dock-sep" aria-hidden="true" />
      </>
    )
  }
  <a class="dock-resume" href={site.resume} target="_blank" rel="noopener noreferrer">
    Resume
    <ArrowUpRight stroke-width={2.2} />
  </a>
  <button class="icon-btn dock-btn dock-email" type="button" aria-label={`Copy email address (${site.email})`} data-email={site.email}>
    <Mail class="i-mail" />
    <Check class="i-check" stroke-width={2.4} />
  </button>
  <a class="icon-btn dock-btn" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
    <GitHub />
  </a>
  <a class="icon-btn dock-btn" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
    <LinkedIn />
  </a>
  {
    sections && (
      <>
        <span class="dock-sep" aria-hidden="true" />
        <button class="icon-btn dock-btn" type="button" popovertarget="section-nav" aria-label="Jump to section">
          <Sections />
        </button>
      </>
    )
  }
  <span class="sr-only" aria-live="polite" data-dock-status></span>
</nav>

<script>
  import { COPIED_MS, copyText } from "@/scripts/clipboard";

  const dock = document.querySelector<HTMLElement>(".dock")!;
  const hero = document.querySelector("[data-hero]");
  const status = dock.querySelector<HTMLElement>("[data-dock-status]")!;

  // show once the hero (name + sidebar actions) is out of view, or straight away on small screens
  // when pinned; inert while hidden so it can't be tabbed to
  const small = matchMedia("(width < 64rem)");
  const pinned = dock.hasAttribute("data-pinned-small");
  let heroGone = !hero;
  const update = () => {
    const shown = heroGone || (pinned && small.matches);
    dock.dataset.shown = String(shown);
    dock.inert = !shown;
  };
  if (hero)
    new IntersectionObserver(([entry]) => {
      heroGone = !entry.isIntersecting;
      update();
    }).observe(hero);
  small.addEventListener("change", update);
  update();

  const email = dock.querySelector<HTMLButtonElement>(".dock-email")!;
  email.addEventListener("click", async () => {
    // the dock shows no address to select, so without clipboard access open the mail app instead
    if (!(await copyText(email.dataset.email!))) return void (location.href = `mailto:${email.dataset.email}`);
    email.classList.add("is-done");
    status.textContent = "Email address copied";
    setTimeout(() => {
      email.classList.remove("is-done");
      status.textContent = "";
    }, COPIED_MS);
  });
</script>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: calc(100% - 24px); /* of the viewport, without a classic scrollbar (unlike 100vw) */
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 16px 40px -18px rgb(0 0 0 / 0.55);
    translate: -50% calc(100% + 24px);
    opacity: 0;
    transition: translate 0.45s var(--ease-spring), opacity 0.25s ease;
  }
  .dock[data-shown="true"] {
    translate: -50% 0;
    opacity: 1;
  }
  /* pinned: shown from the first paint rather than when the script runs, so it doesn't spring up
     on every page load; named so it holds still through the page transition */
  @media (width < 64rem) {
    .dock[data-pinned-small] {
      translate: -50% 0;
      opacity: 1;
      view-transition-name: dock;
    }
  }

  .dock-resume {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding-inline: 14px;
    border-radius: 12px;
    background: var(--peach);
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .dock-resume svg { width: 15px; height: 15px; }
  .dock-btn { width: 44px; height: 44px; flex: none; } /* 44px touch targets */
  .dock-sep { width: 1px; height: 24px; margin-inline: 2px; background: var(--line); }

  .dock-email .i-check { display: none; }
  .dock-email.is-done { color: var(--peach); border-color: var(--peach); }
  .dock-email.is-done .i-mail { display: none; }
  .dock-email.is-done .i-check { display: block; }

  /* desktop keeps these actions in the sticky sidebar (set here, not with lg:hidden,
     because unlayered component CSS would beat the Tailwind utility) */
  @media (width >= 64rem) {
    .dock:not(.dock--desktop) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock { transition: opacity 0.15s ease; }
  }
</style>
