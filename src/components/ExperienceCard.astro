---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import type { ExperienceItem } from "@/data/site";
import { formatMonth } from "@/lib/projects";

interface Props {
  item: ExperienceItem;
}
const { item } = Astro.props;
---

<li class="relative grid gap-x-6 gap-y-1.5 rounded-2xl border border-transparent p-5 sm:grid-cols-[116px_minmax(0,1fr)]" data-blip>
  {/* stacked in the narrow side column, one line on phones where it spans the card */}
  <span class="font-mono text-xs/[1.9] font-medium tracking-[0.06em] text-muted uppercase">
    <time datetime={item.start}>{formatMonth(item.start)}</time> —{" "}
    <span class="sm:block">{item.end ? <time datetime={item.end}>{formatMonth(item.end)}</time> : "Present"}</span>
  </span>
  <div class="min-w-0">
    <h3 class="text-[1.05rem] leading-snug font-semibold">{item.title}</h3>
    {
      item.org && (
        <p class="mt-0.5 flex items-start gap-1.5 text-[0.92rem] leading-snug font-medium text-peri">
          {/* white in both modes: favicons are drawn for light browser tabs */}
          {/* a true squircle where corner-shape is supported, a rounded square elsewhere */}
          <span class="-my-0.5 grid size-6 shrink-0 place-items-center rounded-[7px] border border-line bg-white font-mono text-[11px] text-[#172033] supports-[corner-shape:squircle]:rounded-full supports-[corner-shape:squircle]:[corner-shape:squircle]" aria-hidden="true">
            {item.org.logo ? <img src={item.org.logo} alt="" width="16" height="16" class="size-4 rounded-[3px]" /> : item.org.name.replace(/^\W+/, "").charAt(0).toUpperCase()}
          </span>
          {item.org.href ? (
            <a href={item.org.href} target="_blank" rel="noopener noreferrer" class="group/org text-link underline decoration-link/35 underline-offset-3 transition-[text-decoration-color] hover:decoration-link">
              {/* the last word and the arrow stay together, so the arrow never wraps onto a line alone */}
              {item.org.name.replace(/\S+$/, "")}
              <span class="whitespace-nowrap">
                {item.org.name.match(/\S+$/)?.[0]}
                <ArrowUpRight class="spring ml-0.5 inline-block size-3.5 align-[-2px] transition-transform duration-450 group-hover/org:translate-x-0.5 group-hover/org:-translate-y-0.5" />
                <span class="sr-only">(opens in new tab)</span>
              </span>
            </a>
          ) : (
            <span>{item.org.name}</span>
          )}
        </p>
      )
    }
    <p class="mt-1 text-[0.95rem] text-muted">{item.body}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">{item.chips.map((c) => <span class="chip">{c}</span>)}</div>
  </div>
</li>
