---
/**
 * Below `lg` the sidebar's section list is hidden, so every section heading opens this
 * bottom sheet instead (native popover: light dismiss, Esc, focus return and the openers'
 * aria-expanded for free).
 * It also carries the theme/sound toggles, which scroll away with the hero on small screens.
 */
import X from "@lucide/astro/icons/x";
import SoundToggle from "@/components/SoundToggle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav id="section-nav" popover aria-label="Jump to section" data-toc class="lg:hidden">
  <div class="mb-3 flex items-center justify-between">
    <p class="eyebrow">Jump to</p>
    <button
      type="button"
      popovertarget="section-nav"
      popovertargetaction="hide"
      class="icon-btn size-8 rounded-lg"
      aria-label="Close">
      <X />
    </button>
  </div>
  <ol class="grid gap-1">
    {
      sections.map((s, i) => (
        <li>
          <a
            href={`#${s.id}`}
            class="group/item flex items-center gap-3 rounded-xl px-3 py-3 text-lg font-medium text-muted hover:bg-chip hover:text-fg current:bg-chip current:text-fg">
            <span class="w-6 font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</span>
            {s.label}
            <span class="ml-auto size-2 rounded-full bg-peach opacity-0 group-current/item:opacity-100" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
  <div class="mt-3 flex items-center gap-2.5 border-t border-line px-3 pt-4">
    <p class="mr-auto eyebrow">Settings</p>
    <ThemeToggle />
    <SoundToggle />
  </div>
</nav>

<script>
  import { jumpTo } from "@/scripts/jump";

  const sheet = document.getElementById("section-nav")!;
  // Closing a popover returns focus to its opener, which would scroll back to that heading.
  // So close first, then jump and move focus to the target section without a second scroll.
  sheet.querySelectorAll<HTMLAnchorElement>("a[href^='#']").forEach((a) =>
    a.addEventListener("click", (e) => {
      if (!document.querySelector(a.hash)) return;
      e.preventDefault();
      sheet.hidePopover();
      jumpTo(a.hash);
    }),
  );
  // A tap on the dimmed backdrop closes the sheet (light dismiss), but a popover's ::backdrop
  // doesn't catch the tap, so it would also hit whatever link/button sits underneath.
  // Swallow the click that follows a pointerdown outside the open sheet.
  let swallow = false;
  document.addEventListener(
    "pointerdown",
    (e) => (swallow = sheet.matches(":popover-open") && !sheet.contains(e.target as Node)),
    true,
  );
  document.addEventListener("pointercancel", () => (swallow = false), true); // e.g. turned into a scroll
  document.addEventListener(
    "click",
    (e) => {
      if (!swallow) return;
      swallow = false;
      e.preventDefault();
      e.stopPropagation();
    },
    true,
  );

</script>

<style>
  /* bottom sheet; entry animates via @starting-style, exit where `overlay` is supported */
  #section-nav {
    inset: auto 0 0;
    width: min(100%, 32rem);
    margin: 0 auto;
    max-height: 80dvh;
    overflow-y: auto;
    padding: 18px 16px calc(18px + env(safe-area-inset-bottom, 0px));
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 20px 20px 0 0;
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 -20px 60px -20px rgb(0 0 0 / 0.5);
    translate: 0 100%;
    transition-property: translate, display, overlay;
    transition-duration: 0.35s;
    transition-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    transition-behavior: allow-discrete;
  }
  #section-nav:popover-open {
    translate: 0 0;
    @starting-style { translate: 0 100%; }
  }
  #section-nav::backdrop {
    background: rgb(5 8 15 / 0);
    transition-property: background-color, display, overlay;
    transition-duration: 0.35s;
    transition-behavior: allow-discrete;
  }
  #section-nav:popover-open::backdrop {
    background: rgb(5 8 15 / 0.55);
    @starting-style { background: rgb(5 8 15 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #section-nav, #section-nav::backdrop { transition-duration: 0.01s; }
  }
</style>
