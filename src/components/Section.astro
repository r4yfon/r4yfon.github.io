---
import Sections from "@/components/icons/Sections.astro";

interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<section id={id} class="min-w-0 scroll-mt-12 outline-none">
  <!-- desktop: the sidebar names the section, so the heading is screen-reader only.
       mobile/tablet: the whole heading row opens the section sheet (SectionNav). -->
  <h2 class="mb-5.5 lg:sr-only">
    <button
      type="button"
      popovertarget="section-nav"
      class="group/head eyebrow flex w-full cursor-pointer items-center gap-3 py-1 text-left hover:text-fg lg:hidden">
      {label}
      <span class="h-px flex-1 bg-line transition-colors group-hover/head:bg-peri" aria-hidden="true"></span>
      <Sections class="size-4 shrink-0" />
    </button>
    <span class="hidden lg:inline">{label}</span>
  </h2>
  <slot />
</section>
