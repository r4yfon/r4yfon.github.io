---
// unique per copy: the toggle appears more than once on a page (sidebar + section sheet)
const maskId = `moon-mask-${Math.random().toString(36).slice(2, 8)}`;
---

<button class="icon-btn theme-btn" type="button" aria-label="Dark theme" aria-pressed="false">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <mask id={maskId}><rect width="24" height="24" fill="#fff"></rect><circle class="moon-cut" cx="30" cy="0" r="6" fill="#000"></circle></mask>
    <g class="sun-moon">
      <circle cx="12" cy="12" r="5.5" fill="currentColor" stroke="none" mask={`url(#${maskId})`}></circle>
      <path class="rays" d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M4.6 19.4 6 18M18 6l1.4-1.4"></path>
    </g>
  </svg>
</button>

<script>
  import { blip } from "@/scripts/sound";

  const root = document.documentElement;
  // defined by Base.astro's inline head script, which owns data-theme, data-mode and the color-scheme meta
  const { rfSetTheme } = window as unknown as Window & { rfSetTheme(theme: string | null): void };
  const osDark = matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
  const paint = () => buttons.forEach((b) => b.setAttribute("aria-pressed", String(root.dataset.mode === "dark")));

  // Two visible states, three underlying ones: flipping to the OS's own scheme clears the override
  // (so the site follows the OS again), flipping away from it pins the opposite.
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = root.dataset.mode === "dark" ? "light" : "dark";
      const followOs = next === (osDark.matches ? "dark" : "light");
      rfSetTheme(followOs ? null : next);
      try {
        if (followOs) localStorage.removeItem("rf-theme");
        else localStorage.setItem("rf-theme", next);
      } catch {}
      blip(next === "dark" ? 330 : 660);
    }),
  );
  // data-mode also changes with the OS or another tab (Base.astro), so watch it rather than the clicks
  new MutationObserver(paint).observe(root, { attributeFilter: ["data-mode"] });
  paint();
</script>

<style>
  /* sun ↔ moon: the rays shrink away and a masking circle slides in to carve the crescent */
  .sun-moon { transform-origin: 12px 12px; transition: transform 0.6s var(--ease-spring); }
  .rays { transform-origin: center; transition: transform 0.6s var(--ease-spring), opacity 0.3s; }
  .moon-cut { transition: cx 0.5s var(--ease-spring), cy 0.5s var(--ease-spring); }
  :global([data-mode="dark"]) .sun-moon { transform: rotate(40deg); }
  :global([data-mode="dark"]) .rays { transform: scale(0); opacity: 0; }
  :global([data-mode="dark"]) .moon-cut { cx: 17px; cy: 7px; }
</style>
