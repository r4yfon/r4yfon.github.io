---
// The "time machine": a native <details>, so it opens and closes without any script.
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { changelog, site } from "@/data/site";
---

<footer class="flex justify-start text-[0.88rem] text-muted">
  <details class="changelog group/log max-w-full">
    <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-full bg-chip px-2.5 py-1.5 font-mono text-xs font-medium text-chip-fg [&::-webkit-details-marker]:hidden">
      <!-- a green "live" dot: this is the version you're looking at -->
      <span class="size-1.75 rounded-full bg-[#5fd38d] shadow-[0_0_0_3px_rgb(95_211_141/0.2)]"></span>
      v{site.version} · changelog
      <span class="transition-transform group-open/log:rotate-90">›</span>
    </summary>
    <!-- The margin centres the 2px rule under the pill's status dot. -->
    <ol class="mt-3 ml-[12.5px] grid gap-1 border-l-2 border-line py-1 pl-4 font-mono text-[13px]/[1.7]">
      {
        changelog.map((v) => (
          <li>
            {v.href ? (
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="group/ver hover:text-fg">
                <b class="font-medium text-fg">v{v.version}</b> ({v.year}) · {v.note}
                <ArrowUpRight class="spring ml-1 inline-block size-3.5 align-[-2px] transition-transform duration-450 group-hover/ver:translate-x-0.5 group-hover/ver:-translate-y-0.5" />
                <span class="sr-only">(opens in new tab)</span>
              </a>
            ) : (
              <span>
                <b class="font-medium text-fg">v{v.version}</b> ({v.year}) · {v.note}
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </details>
</footer>

<style>
  /* Animate the open/close where ::details-content is supported; elsewhere it just toggles. */
  @media (prefers-reduced-motion: no-preference) {
    .changelog {
      interpolate-size: allow-keywords;
    }
    .changelog::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size 0.2s cubic-bezier(0.4, 0, 1, 1),
        opacity 0.15s ease-in,
        content-visibility 0.2s allow-discrete;
    }
    .changelog[open]::details-content {
      block-size: auto;
      opacity: 1;
      /* Snappy, overshoots slightly and settles. */
      transition:
        block-size 0.32s cubic-bezier(0.34, 1.45, 0.64, 1),
        opacity 0.18s ease-out,
        content-visibility 0.32s allow-discrete;
    }
    .changelog ol {
      transform-origin: top left;
      transition: translate 0.2s cubic-bezier(0.4, 0, 1, 1);
      translate: 0 -6px;
    }
    .changelog[open] ol {
      translate: 0 0;
      transition: translate 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
</style>
