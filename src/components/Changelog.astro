---
// The "time machine": a native <details>, so it opens and closes without any script.
import { changelog, site } from "@/data/site";
---

<footer class="flex justify-end text-[0.88rem] text-muted">
  <details class="group/log max-w-full">
    <summary class="ml-auto flex w-fit cursor-pointer list-none items-center gap-2 rounded-full bg-chip px-2.5 py-1.5 font-mono text-xs font-medium text-chip-fg [&::-webkit-details-marker]:hidden">
      <span class="size-1.75 rounded-full bg-[#5fd38d] shadow-[0_0_0_3px_rgb(95_211_141/0.2)]"></span>
      v{site.version} · changelog
      <span class="transition-transform group-open/log:rotate-90">›</span>
    </summary>
    <ol class="mt-3 grid gap-1 border-l-2 border-line py-1 pl-4 font-mono text-[13px]/[1.7]">
      {
        changelog.map((v) => (
          <li>
            <a href={v.href} class="hover:text-fg">
              <b class="font-medium text-fg">v{v.version}</b> ({v.year}) · {v.note}
            </a>
          </li>
        ))
      }
    </ol>
  </details>
</footer>
