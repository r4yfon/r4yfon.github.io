---
import Logo from "@/components/Logo.astro";
import SoundToggle from "@/components/SoundToggle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/data/site";

interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<header class="flex flex-col gap-7 pt-14 pb-6 lg:sticky lg:top-0 lg:h-dvh lg:justify-between lg:py-22">
  <div>
    <Logo />
    <h1 class="group/name mt-4.5 mb-2.5 font-display text-[clamp(2.6rem,5vw,3.6rem)] leading-[1.02] tracking-[-0.01em]">
      {site.name} <span class="wave inline-block origin-[70%_80%]">👋</span>
    </h1>
    <p class="text-lg font-medium">
      {site.roles[0]} <span class="px-1 font-mono text-peach">×</span> {site.roles[1]}
    </p>
    <p class="mt-3.5 max-w-[34ch] text-muted">{site.pitch}</p>

    <nav class="toc mt-12 hidden lg:block" aria-label="Sections" data-toc>
      <ol class="grid gap-1">
        {
          sections.map((s, i) => (
            <li>
              <a
                href={`#${s.id}`}
                class:list={["group/toc inline-flex items-center gap-3.5 py-2 eyebrow hover:text-fg [&.active]:text-fg", { active: i === 0 }]}>
                <span class="spring h-px w-8 bg-current transition-[width,background-color] duration-450 group-hover/toc:w-18 group-hover/toc:bg-peach group-[.active]/toc:w-18 group-[.active]/toc:bg-peach" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="flex flex-wrap items-center gap-2.5">
    <a
      class="group/resume spring inline-flex h-10 items-center gap-2 rounded-xl bg-peach px-4 text-sm font-semibold text-accent-ink transition duration-450 hover:-translate-y-[3px] hover:-rotate-[1.5deg] hover:shadow-[0_10px_24px_-10px_var(--peach)]"
      href={site.resume}
      target="_blank"
      rel="noopener noreferrer">
      Resume
      <svg class="spring size-4 transition-transform duration-450 group-hover/resume:translate-x-0.5 group-hover/resume:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
    </a>
    <a class="icon-btn" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
    </a>
    <a class="icon-btn" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="4"></rect><path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0"></path></svg>
    </a>
    <span class="mx-1 h-6 w-px bg-line" aria-hidden="true"></span>
    <ThemeToggle />
    <SoundToggle />
  </div>
</header>

<script>
  // highlight the section currently in view, in every section list (sidebar + mobile sheet)
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[href^='#']")];
  const ids = [...new Set(links.map((a) => a.hash))];
  const sections = ids.map((id) => document.querySelector<HTMLElement>(id)!);
  const spy = () => {
    const line = innerHeight * 0.35;
    let idx = 0;
    sections.forEach((s, i) => {
      if (s.getBoundingClientRect().top - line <= 0) idx = i;
    });
    if (innerHeight + scrollY >= document.body.scrollHeight - 4) idx = sections.length - 1;
    links.forEach((a) => {
      const on = a.hash === ids[idx];
      a.classList.toggle("active", on);
      if (on) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
  };
  addEventListener("scroll", spy, { passive: true });
  spy();
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .group\/name:hover .wave { animation: wave 1s ease-in-out; }
  }
  @keyframes wave {
    20% { rotate: 14deg; }
    40% { rotate: -8deg; }
    60% { rotate: 12deg; }
    80% { rotate: -4deg; }
  }
</style>
