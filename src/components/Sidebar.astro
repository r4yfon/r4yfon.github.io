---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import GitHub from "@/components/icons/GitHub.astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import Logo from "@/components/Logo.astro";
import LogoMotionToggle from "@/components/LogoMotionToggle.astro";
import SoundToggle from "@/components/SoundToggle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/data/site";

interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<header data-hero class="flex flex-col gap-7 pt-14 pb-6 lg:sticky lg:top-0 lg:h-dvh lg:justify-between lg:py-22">
  <div>
    <div class="flex items-end gap-1.5">
      <Logo size={60} every={10} />
      <LogoMotionToggle />
    </div>
    <h1 class="mt-4.5 mb-2.5 font-display text-[clamp(2.6rem,5vw,3.6rem)] leading-[1.02] tracking-[-0.01em]">
      {site.name} <span aria-hidden="true">👋</span>
    </h1>
    <p class="text-lg font-medium">
      {site.roles[0]} <span class="px-1 font-mono text-peach">×</span> {site.roles[1]}
    </p>
    <p class="mt-3.5 max-w-[34ch] text-muted">{site.pitch}</p>

    <nav class="toc mt-12 hidden lg:block" aria-label="Sections" data-toc>
      <ol class="grid gap-1">
        {
          sections.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                class="group/toc inline-flex items-center gap-3.5 py-2 eyebrow hover:text-fg current:text-fg">
                <span class="spring h-px w-8 bg-current transition-[width,background-color] duration-450 group-hover/toc:w-18 group-hover/toc:bg-peach group-current/toc:w-18 group-current/toc:bg-peach" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="flex flex-wrap items-center gap-2.5">
    <a
      class="group/resume spring inline-flex h-10 items-center gap-2 rounded-xl bg-peach px-4 text-sm font-semibold text-accent-ink transition duration-450 hover:-translate-y-[3px] hover:-rotate-[1.5deg] hover:shadow-[0_10px_24px_-10px_var(--peach)]"
      href={site.resume}
      target="_blank"
      rel="noopener noreferrer">
      Resume
      <ArrowUpRight class="spring size-4 transition-transform duration-450 group-hover/resume:translate-x-0.5 group-hover/resume:-translate-y-0.5" stroke-width={2.2} />
    </a>
    <a class="icon-btn" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <GitHub />
    </a>
    <a class="icon-btn" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <LinkedIn />
    </a>
    <span class="mx-1 h-6 w-px bg-line" aria-hidden="true"></span>
    <ThemeToggle />
    <SoundToggle />
  </div>
</header>

<script>
  import { jumpTo } from "@/scripts/jump";

  // Highlight the section currently in view, in every section list (sidebar + mobile sheet).
  // Where `scroll-target-group` is supported the browser does it (global.css) and we only mirror
  // :target-current into aria-current; elsewhere a scroll listener sets .active itself.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[href^='#']")];
  const mark = (isOn: (a: HTMLAnchorElement) => boolean) =>
    links.forEach((a) => {
      if (isOn(a)) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });

  if (CSS.supports("scroll-target-group: auto")) {
    // read it just after the next frame: the browser picks the current target after layout,
    // which runs after rAF callbacks, so the task queued from rAF sees the fresh value
    const sync = () => requestAnimationFrame(() => setTimeout(() => mark((a) => a.matches(":target-current"))));
    addEventListener("scrollend", sync);
    if (document.readyState === "complete") sync();
    else addEventListener("load", sync, { once: true });
  } else {
    const ids = [...new Set(links.map((a) => a.hash))];
    const sections = ids.map((id) => document.querySelector<HTMLElement>(id)!);
    const spy = () => {
      const line = innerHeight * 0.35;
      let idx = 0;
      sections.forEach((s, i) => {
        if (s.getBoundingClientRect().top - line <= 0) idx = i;
      });
      if (innerHeight + scrollY >= document.body.scrollHeight - 4) idx = sections.length - 1;
      links.forEach((a) => a.classList.toggle("active", a.hash === ids[idx]));
      mark((a) => a.hash === ids[idx]);
    };
    // reading layout once per frame at most, however fast scroll events arrive
    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          spy();
        });
      },
      { passive: true },
    );
    spy();
  }

  document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']").forEach((a) =>
    a.addEventListener("click", (e) => {
      if (jumpTo(a.hash)) e.preventDefault();
    }),
  );
</script>

