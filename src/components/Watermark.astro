---
/**
 * A large, faint R monogram (semicircle under a triangle, like the logo) fixed behind the content. Purely decorative.
 */
---

<svg class="watermark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path class="bowl" d="M0 0h20a10.5 10.5 0 0 1 0 21H0z"></path>
  <path class="stem" d="M0 0l31.2 32H0z"></path>
</svg>

<style>
  .watermark {
    --wm-opacity: 0.07;
    position: fixed;
    right: -6vmin;
    bottom: -8vmin;
    z-index: 0;
    width: min(62vmin, 560px);
    height: auto;
    pointer-events: none;
    rotate: -8deg;
    opacity: var(--wm-opacity);
  }
  .bowl { fill: var(--brand-tan); }
  .stem { fill: var(--brand-blue); }
  :global([data-mode="light"]) .watermark { --wm-opacity: 0.1; }
</style>
