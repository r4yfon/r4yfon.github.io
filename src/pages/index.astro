---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Changelog from "@/components/Changelog.astro";
import CopyEmail from "@/components/CopyEmail.astro";
import Dock from "@/components/Dock.astro";
import ExperienceCard from "@/components/ExperienceCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectThumb from "@/components/ProjectThumb.astro";
import Section from "@/components/Section.astro";
import SectionNav from "@/components/SectionNav.astro";
import Sidebar from "@/components/Sidebar.astro";
import Watermark from "@/components/Watermark.astro";
import { about, experience, principles, site } from "@/data/site";
import Base from "@/layouts/Base.astro";
import { formatMonth, getProjects, vt } from "@/lib/projects";

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const android = projects.filter((p) => p.data.kind === "android");
const more = projects.filter((p) => !p.data.featured && p.data.kind !== "android");
const roles = experience.filter((e) => e.kind !== "education");
const education = experience.filter((e) => e.kind === "education");

const sections = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Project highlights" },
  { id: "principles", label: "How I build" },
];
---

{/* expect: coming back from a project page, its card (thumb-/title-<id>) has to be parsed before the snapshot, or the morph turns into a fade */}
<Base expect="projects">
  <Watermark />
  <div class="relative z-1 mx-auto grid max-w-320 gap-6 px-[clamp(16px,5vw,64px)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.3fr)] lg:gap-16">
    <Sidebar sections={sections} />

    <main id="main" tabindex="-1" class="grid min-w-0 gap-22 pb-32 outline-none lg:py-22">
      <Section id="about" label="About">
        <div class="grid max-w-[62ch] gap-4 text-muted [&_mark]:bg-[linear-gradient(transparent_62%,color-mix(in_srgb,var(--peach)_32%,transparent)_0)] [&_mark]:bg-transparent [&_mark]:text-fg [&_strong]:font-medium [&_strong]:text-fg">
          {about.map((paragraph) => <p set:html={paragraph} />)}
        </div>
        <div class="mt-5.5"><CopyEmail /></div>
      </Section>

      <Section id="experience" label="Experience">
        <ol class="grid gap-3.5">
          {roles.map((item) => <ExperienceCard item={item} />)}
        </ol>
        {
          education.length > 0 && (
            <>
              <p id="education-label" class="eyebrow mt-7.5 mb-3.5 px-5">Education</p>
              <ol class="grid gap-3.5" aria-labelledby="education-label">
                {education.map((item) => <ExperienceCard item={item} />)}
              </ol>
            </>
          )
        }
      </Section>

      <Section id="projects" label="Project highlights">
        <ol class="group/list grid gap-3.5">
          {featured.map((p) => <ProjectCard project={p} />)}
        </ol>

        {
          android.length > 0 && (
            <div class="mt-8 px-5">
              <h3 class="eyebrow mb-3">Android, three apps in one exchange semester</h3>
              <ul class="grid grid-cols-3 gap-3">
                {android.map((p) => (
                  <li id={`project-${p.id}`} class="scroll-mt-24">
                    <a href={`/projects/${p.id}/`} class="group/app grid gap-2" data-blip>
                      <ProjectThumb project={p} class="spring aspect-square transition-transform duration-500 group-hover/app:-translate-y-1 group-hover/app:-rotate-2" />
                      <span class="w-fit text-sm font-medium" style={vt.title(p.id)}>
                        {p.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          more.length > 0 && (
            <div class="mt-8 px-5">
              <h3 class="eyebrow mb-3">Other projects</h3>
              <ul class="grid gap-1">
                {more.map((p) => (
                  <li id={`project-${p.id}`} class="scroll-mt-24">
                    <a href={`/projects/${p.id}/`} class="group/more flex items-baseline justify-between gap-4 border-b border-line py-2.5 hover:text-peach" data-blip>
                      <span class="font-medium" style={vt.title(p.id)}>
                        {p.data.title}
                      </span>
                      <span class="shrink-0 font-mono text-xs text-muted">{formatMonth(p.data.date)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <a class="group/gh mt-6 inline-flex items-center gap-2 px-5 font-medium" href={site.github} target="_blank" rel="noopener noreferrer">
          See everything on GitHub <ArrowRight class="spring size-4 text-peach transition-transform duration-450 group-hover/gh:translate-x-1.5" aria-hidden="true" />
        </a>
      </Section>

      <Section id="principles" label="How I build">
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            principles.map((p) => (
              <li class="lift rounded-2xl border border-line bg-surface px-5 py-4.5 hover:-translate-y-1 hover:rotate-[0.4deg] hover:border-peri" data-blip>
                <b class="mb-1 block font-display text-xl font-normal">{p.title}</b>
                <span class="text-[0.93rem] text-muted">{p.body}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Changelog />
    </main>
  </div>
  <SectionNav sections={sections} />
  <Dock sections />
</Base>
