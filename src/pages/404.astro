---
import Logo from "@/components/Logo.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Not found">
  <main id="main" tabindex="-1" class="relative z-1 mx-auto grid outline-none min-h-dvh max-w-xl place-content-center gap-5 px-4 text-center">
    <div class="mx-auto"><Logo size={64} /></div>
    <h1 class="font-display text-4xl">This page didn't ship.</h1>
    <p class="text-muted">The link may be old, or the page moved in the v3 rebuild. Looking for the previous site? It lives at <a class="text-fg underline decoration-peach underline-offset-3" href="/v2/">/v2/</a>.</p>
    <a href="/" class="mx-auto mt-2 w-fit rounded-xl bg-peach px-4 py-2 text-sm font-semibold text-accent-ink">Back to the portfolio</a>
  </main>
</Base>
